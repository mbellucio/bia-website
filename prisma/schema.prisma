generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  password  String
  email     String   @unique
  username  String?  @unique
  createdAt DateTime @default(now())
  active   Boolean  @default(true)
}